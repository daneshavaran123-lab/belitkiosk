<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- کتابخانهٔ کارت‌خوان فقط روی ویندوز و روی .NET Framework کار می‌کند -->
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>PosBridge</AssemblyName>
    <RootNamespace>PosBridge</RootNamespace>
    <LangVersion>latest</LangVersion>
    <PlatformTarget>x86</PlatformTarget>
    <UseWindowsForms>false</UseWindowsForms>
  </PropertyGroup>

  <ItemGroup>
    <!-- پروژهٔ تست جداگانه است و نباید داخل سرویس کامپایل شود -->
    <Compile Remove="tests/**" />
    <None Remove="tests/**" />
  </ItemGroup>

  <ItemGroup>
    <!-- بدون نصب Developer Pack هم build شود (روی خود کیوسک یا CI) -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- کتابخانهٔ رسمی PC-POS — فقط برای protocol = "sdk" یا اتصال USB -->
    <Reference Include="PosInterface">
      <HintPath>lib\PosInterface.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="System.Drawing" />
    <Reference Include="System.Web.Extensions" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
